# Porta do servidor (default: 3000)
PORT=3000

# Chave de API para proteger endpoints (opcional, mas recomendada em produção)
API_KEY=

# Configurações Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Logging
LOG_LEVEL=info

# CORS - origens permitidas separadas por vírgula (vazio = permite todas)
ALLOWED_ORIGINS=

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Tamanho máximo do request body em bytes (default: 1MB)
MAX_BODY_SIZE=1048576
